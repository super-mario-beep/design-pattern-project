<div class="auth">
  <div class="auth-card auth-card--wide card">
    <h1>Create an account</h1>
    <p class="muted">Pick a package now, you can change it later once a day.</p>

    <%= render "shared/oauth_buttons" %>

    <%= render "shared/errors", record: @user %>

    <%= form_with model: @user, url: registration_path, class: "form" do |form| %>
      <div class="field-row">
        <div class="field">
          <%= form.label :name %>
          <%= form.text_field :name, required: true, autofocus: true %>
        </div>
        <div class="field">
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autocomplete: "username" %>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
        </div>
        <div class="field">
          <%= form.label :password_confirmation %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
        </div>
      </div>

      <div class="field">
        <span class="label">Package</span>
        <div class="tier-options">
          <% Tiers.all.each do |tier| %>
            <%= render "tiers/option", form: form, field: :tier_name, tier: tier %>
          <% end %>
        </div>
      </div>

      <%= form.submit "Create account", class: "button button--block" %>
    <% end %>

    <div class="auth-links">
      <span>Already have an account? <%= link_to "Log in", new_session_path %></span>
    </div>
  </div>
</div>
