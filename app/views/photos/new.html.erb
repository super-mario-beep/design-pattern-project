<div class="page-header">
  <div>
    <h1>Upload a photo</h1>
    <p class="page-header__subtitle">JPG, PNG or BMP. Choose how the photo is processed before it is saved.</p>
  </div>
</div>

<div class="with-sidebar">
  <%= form_with scope: :photo, url: photos_path, class: "form card" do |form| %>
    <div class="field">
      <%= form.label :file, "Photo" %>
      <%= form.file_field :file, accept: "image/jpeg,image/png,image/bmp", required: true %>
    </div>

    <div class="field">
      <%= form.label :description %>
      <%= form.text_area :description, value: @upload[:description], rows: 3 %>
    </div>

    <div class="field">
      <%= form.label :hashtags %>
      <%= form.text_field :hashtags, value: @upload[:hashtags], placeholder: "#sunset #beach" %>
    </div>

    <fieldset>
      <legend>Processing before saving</legend>

      <div class="field-row">
        <div class="field">
          <%= form.label :resize_width, "Max width (px)" %>
          <%= form.number_field :resize_width, value: @upload[:resize_width], min: 1 %>
        </div>
        <div class="field">
          <%= form.label :resize_height, "Max height (px)" %>
          <%= form.number_field :resize_height, value: @upload[:resize_height], min: 1 %>
        </div>
        <div class="field">
          <%= form.label :format %>
          <%= form.select :format, [ [ "Keep original", "" ], [ "JPG", "jpg" ], [ "PNG", "png" ], [ "BMP", "bmp" ] ], selected: @upload[:format] %>
        </div>
      </div>

      <div class="checkbox-row">
        <div class="checkbox">
          <%= form.check_box :sepia, checked: @upload[:sepia] == "1" %>
          <%= form.label :sepia, "Sepia" %>
        </div>
        <div class="checkbox">
          <%= form.check_box :blur, checked: @upload[:blur] == "1" %>
          <%= form.label :blur, "Blur" %>
        </div>
      </div>
    </fieldset>

    <div class="actions">
      <%= form.submit "Upload photo", class: "button" %>
    </div>
  <% end %>

  <aside>
    <%= render "tiers/usage", user: current_user %>
  </aside>
</div>
